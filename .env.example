COMPOSE_PROJECT_NAME=pkb-service-local

PKB_POSTGRES_DB=pkb
PKB_POSTGRES_USER=pkb
PKB_POSTGRES_PASSWORD=pkb-local-password
PKB_POSTGRES_PORT=5432
PKB_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pkb
PKB_DATASOURCE_USERNAME=pkb
PKB_DATASOURCE_PASSWORD=pkb-local-password
PKB_FLYWAY_ENABLED=true

PKB_KAFKA_PORT=9092
PKB_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PKB_KAFKA_COMMAND_INGRESS_TOPIC=pkb.commands.ingress.v1
PKB_KAFKA_COMMAND_DLT_TOPIC=pkb.commands.ingress.dlt.v1
PKB_KAFKA_COMMAND_REPLAY_TOPIC=pkb.commands.ingress.replay.v1
PKB_KAFKA_COMMAND_CONSUMER_GROUP_ID=pkb-command-writer
PKB_KAFKA_PRODUCER_SERVICE=pkb-service
PKB_KAFKA_COMMAND_INGRESS_ENABLED=true
PKB_KAFKA_COMMAND_MAX_RETRIES=3
PKB_KAFKA_COMMAND_RETRY_INITIAL_INTERVAL=250ms
PKB_KAFKA_COMMAND_RETRY_MULTIPLIER=2.0
PKB_KAFKA_COMMAND_RETRY_MAX_INTERVAL=5s

PKB_MINIO_ROOT_USER=pkb-local-access
PKB_MINIO_ROOT_PASSWORD=pkb-local-secret
PKB_MINIO_API_PORT=9000
PKB_MINIO_CONSOLE_PORT=9001
PKB_S3_ENDPOINT=http://localhost:9000
PKB_S3_BUCKET=pkb-local
PKB_S3_REGION=eu-central-1
PKB_S3_ACCESS_KEY=pkb-local-access
PKB_S3_SECRET_KEY=pkb-local-secret
PKB_S3_PATH_STYLE_ACCESS_ENABLED=true

PKB_OPA_PORT=8181
PKB_OPA_BASE_URL=http://localhost:8181
PKB_OPA_DECISION_PATH=/v1/data/biocompass/pkb/authz/decision
PKB_AU_DECISION_URL=http://localhost:8181/v1/data/biocompass/pkb/authz/decision
PKB_AU_SERVICE_NAME=pkb-service
PKB_AU_SERVICE_TOKEN=
PKB_AU_TIMEOUT=5s

PKB_AUTH_DEFAULT_PURPOSE=self
PKB_AUTH_INTROSPECTION_URL=http://localhost:8001/api/v1/internal/auth/token/introspect/
PKB_AUTH_INTROSPECTION_SERVICE_NAME=pkb-service
PKB_AUTH_INTROSPECTION_SERVICE_TOKEN=pkb-local-introspection-secret
PKB_AUTH_INTROSPECTION_TIMEOUT_SECONDS=5
